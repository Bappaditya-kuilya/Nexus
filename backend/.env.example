# Copy to .env and fill in values. Unset = sensible default (see comments).

# Required in production — random secret generated at startup if missing (insecure for multi-process).
JWT_SECRET=change-me-to-a-random-string

# Token lifetimes (defaults shown)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# OTP settings
OTP_EXPIRE_MINUTES=10

# Email delivery. Leave SMTP_HOST unset to print OTPs to the console (dev mode).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# SQLite path (defaults to ./data.db)
NPTEL_DB=./data.db

# CORS origin for the website frontend
CORS_ORIGIN=http://localhost:3000
